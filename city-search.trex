<?xml version='1.0' encoding='utf-8'?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.yourcompany.citysearch" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name>City Search Geocoder</name>
    <description>Search for a US city and plot it via lat/long parameters.</description>
    <author name="Erik English" email="erik.english@acf.hhs.gov" organization="ORR/DAIM" website="https://acf-main-dev.acf.gov/orr/research-data/uac"/>
    <min-api-version>1.9</min-api-version>
    <source-location>
      <url>http://localhost:8765/city-search.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAAXNSR0IArs4c6QAAAA1JREFUCB1jYGBg+A8AAQQBAB1sJhcAAAAASUVORK5CYII=</icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
</manifest>